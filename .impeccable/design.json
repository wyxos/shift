  "narrative": {
    "northStar": "The Workbench",
    "overview": "The Workbench keeps reports, technical context, and follow-up easy to scan. Its character is calm, clear, and practical: compact controls, familiar icons, and restrained emphasis support sustained work.\n\nCool neutral surfaces carry most of the interface. Signal Blue identifies actions and selection; tonal layers and borders separate working areas. Small shadows support controls and cards, while dialogs and sheets use stronger structural depth. Light and dark themes preserve the same hierarchy.",
    "keyCharacteristics": [
      "Compact and restrained controls.",
      "Semantic blue actions with cool neutral surfaces.",
      "Responsive lists and task sheets.",
      "Depth through tonal layers, borders, and modest shadows."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Use existing theme roles for controls, surfaces, and text. Keep the logo color tied to the approved assets; it is a distinct value from the action color.",
        "section": "colors"
      },
      {
        "name": "The Theme Pair Rule",
        "body": "Apply the matching dark role when the dark theme is active. Danger text and filled danger controls use separate roles in dark mode.",
        "section": "colors"
      },
      {
        "name": "The Structural Depth Rule",
        "body": "Use tonal separation and borders for grouping; reserve the stronger overlay shadow for dialogs, sheets, and floating menus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the existing semantic colors, shared controls, and task presentation helpers.",
      "Do preserve the light/dark role pairs and readable invalid, disabled, and selected states.",
      "Do keep compact controls, wrapping action groups, and the existing responsive list/sheet patterns.",
      "Do preserve visible keyboard focus, labelled icon actions, and reduced-motion overrides.",
      "Do use the approved logo, theme-appropriate wordmark, and standalone symbol for collapsed navigation."
    ],
    "donts": [
      "Don't substitute the logo blue for the UI primary token.",
      "Don't turn every status or priority badge into a saturated color block; the shared state badge uses an icon and label on a neutral surface.",
      "Don't assume Instrument Sans is downloaded or present on every device.",
      "Don't turn illustrative docs screenshots into the authority for portal tokens.",
      "Don't replace shared task components with independently styled portal copies."
    ]
  }
}
